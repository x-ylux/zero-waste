# Database connection (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://rescueplate:rescueplate_password@localhost:5432/rescueplate_db?schema=public"

# Environment and Demo Mode
NODE_ENV="development"
DEMO_MODE="true"

# Authentication Session Secret (at least 32 characters)
SESSION_SECRET="rescueplate-super-secure-session-secret-key-at-least-32-chars-long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone (Default for display: Asia/Kolkata)
DEFAULT_TIMEZONE="Asia/Kolkata"

# Map and Distance Provider (options: 'adapter_fallback', 'postgis', 'google')
# If GOOGLE_MAPS_API_KEY is not provided, the app uses straight-line Haversine fallback with clear labels
GEO_PROVIDER="adapter_fallback"
GOOGLE_MAPS_API_KEY=""

# Emissions Calculation (Strictly disabled or explicitly documented with assumptions)
# Default: false -> displays "Not calculated"
CO2_FACTOR_ENABLED="false"
CO2_FACTOR_PER_KG="2.5"
CO2_FACTOR_SOURCE="UN FAO Food Wastage Footprint / WRI Protocol (Simulated benchmark)"

# Notification Provider (in_app, simulated_sms, simulated_email)
NOTIFICATION_PROVIDER="in_app"

