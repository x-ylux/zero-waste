    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
