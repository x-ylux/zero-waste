generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  donor
  ngo
  volunteer
  admin
}

enum DonationStatus {
  available
  reserved
  collected
  delivered
  cancelled
  expired
  rejected
}

enum TaskStatus {
  unassigned
  assigned
  picked_up
  delivered
  backup_needed
  cancelled
}

enum FoodCategory {
  cooked_meals
  packaged_food
  produce
  bakery
  dairy
  beverages
  other
}

enum QuantityUnit {
  servings
  kg
  packets
  boxes
}

model User {
  id          String  @id
  name        String
  email       String  @unique
  role        Role
  phone       String?
  orgId       String?
  volunteerId String?

  notifications Notification[]
  incidents     IncidentReport[]
  handoffs      HandoffEvent[]

  @@map("users")
}

model DonorOrg {
  id          String  @id
  name        String
  kind        String
  contactName String
  phone       String
  address     String
  latitude    Float
  longitude   Float
  location    Unsupported("geography(Point,4326)")?

  donations Donation[]

  @@map("donor_orgs")
}

model NgoProfile {
  id                      String    @id
  name                    String
  coordinatorName         String
  phone                   String
  address                 String
  latitude                Float
  longitude               Float
  location                Unsupported("geography(Point,4326)")?
  acceptedCategories      String
  dietaryRequirements     String
  storageCapabilities     String
  handlingCapabilities    String
  receivingHoursStart     String
  receivingHoursEnd       String
  maxAcceptableQuantity   Int
  quantityUnit            QuantityUnit
  lastCompletedDonationAt DateTime?

  needs NeedsRequest?
  tasks RescueTask[]

  @@map("ngo_profiles")
}

model VolunteerProfile {
  id                    String  @id
  userId                String  @unique
  name                  String
  phone                 String
  address               String
  latitude              Float
  longitude             Float
  location              Unsupported("geography(Point,4326)")?
  available             Boolean
  standby               Boolean
  transportType         String
  carryingCapacity      Int
  capacityUnit          QuantityUnit
  handlingCapabilities  String
  notes                 String?

  tasks RescueTask[]

  @@map("volunteer_profiles")
}

model Donation {
  id                     String         @id
  donorOrgId             String
  createdByUserId        String
  title                  String
  description            String
  category               FoodCategory
  quantity               Float
  unit                   QuantityUnit
  estimatedPortions      Float?
  dietaryTags            String
  allergens              String
  preparedAt             DateTime?
  storage                String
  handlingRequirements   String
  packagingAvailable     Boolean
  pickupAddress          String
  latitude               Float
  longitude              Float
  location               Unsupported("geography(Point,4326)")?
  pickupWindowStart      DateTime
  pickupWindowEnd        DateTime
  contactName            String
  contactPhone           String
  photoDataUrl           String?
  handlingAcknowledged   Boolean
  status                 DonationStatus
  reservedNgoId          String?
  acceptedQuantity       Float?
  rejectionReason        String?
  cancellationReason     String?
  failureReason          String?
  createdAt              DateTime
  updatedAt              DateTime

  donorOrg DonorOrg      @relation(fields: [donorOrgId], references: [id])
  tasks    RescueTask[]
  handoffs HandoffEvent[]
  timeline TimelineEvent[]

  @@map("donations")
}

model NeedsRequest {
  id                    String       @id
  ngoId                 String       @unique
  requiredCategories    String
  requestedQuantity     Float
  quantityUnit          QuantityUnit
  dietaryRequirements   String
  receivingHoursStart   String
  receivingHoursEnd     String
  storageCapabilities   String
  handlingCapabilities  String
  maxAcceptableQuantity Float
  deliveryAddress       String
  deliveryLat           Float
  deliveryLng           Float
  notes                 String?
  updatedAt             DateTime

  ngo NgoProfile @relation(fields: [ngoId], references: [id])

  @@map("needs_requests")
}

model RescueTask {
  id                  String     @id
  donationId          String
  ngoId               String
  volunteerId         String?
  status              TaskStatus
  standbyNotifiedIds  String
  cancellationReason  String?
  failureReason       String?
  createdAt           DateTime
  updatedAt           DateTime

  donation  Donation          @relation(fields: [donationId], references: [id])
  ngo       NgoProfile        @relation(fields: [ngoId], references: [id])
  volunteer VolunteerProfile? @relation(fields: [volunteerId], references: [id])
  handoffs  HandoffEvent[]

  @@map("rescue_tasks")
}

model HandoffEvent {
  id          String   @id
  donationId  String
  taskId      String
  stage       String
  actorUserId String
  actorRole   Role
  quantity    Float?
  notes       String?
  method      String
  createdAt   DateTime

  donation Donation @relation(fields: [donationId], references: [id])
  task     RescueTask @relation(fields: [taskId], references: [id])
  actor    User     @relation(fields: [actorUserId], references: [id])

  @@map("handoff_events")
}

model TimelineEvent {
  id          String  @id
  donationId  String
  taskId      String?
  label       String
  detail      String
  createdAt   DateTime
  actorUserId String?

  donation Donation @relation(fields: [donationId], references: [id])

  @@map("timeline_events")
}

model Notification {
  id                String   @id
  userId            String
  title             String
  message           String
  channel           String
  simulated         Boolean  @default(true)
  read              Boolean  @default(false)
  createdAt         DateTime
  relatedDonationId String?
  relatedTaskId     String?

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model IncidentReport {
  id             String   @id
  donationId     String?
  taskId         String?
  reporterUserId String
  title          String
  description    String
  status         String
  createdAt      DateTime

  reporter User @relation(fields: [reporterUserId], references: [id])

  @@map("incident_reports")
}

model FailureRecord {
  id         String   @id
  donationId String?
  taskId     String?
  reason     String
  notes      String
  createdAt  DateTime

  @@map("failure_records")
}

model ImpactConfigRow {
  id                       String @id @default("default")
  mealEquivalentServings   Float
  mealEquivalentKg         Float
  mealEquivalentPackets    Float
  mealEquivalentBoxes      Float
  kgCo2ePerMealEquivalent  Float
  notes                    String

  @@map("impact_config")
}

/// Convenience snapshot so the same AppState object can be persisted relationally later.
model AppSnapshot {
  id        String   @id @default("default")
  state     Json
  updatedAt DateTime @updatedAt

  @@map("app_snapshots")
}
