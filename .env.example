# Optional PostgreSQL + PostGIS (not required for the localStorage demo)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rescuerelay_db?schema=public"

# Set to "postgres" only when DATABASE_URL is configured and migrations are applied.
# Default demo mode uses the mock repository with browser localStorage.
RESCUE_RELAY_PERSISTENCE="mock"

NODE_ENV="development"
DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Optional browser Maps key. Leave empty to show the location-list fallback.
# Never put server-only secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Server-only Maps key placeholder (unused in mock mode)
GOOGLE_MAPS_API_KEY=""
