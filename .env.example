# Native PostgreSQL with PostGIS (not required for the localStorage demo).
# Replace the example password with your local PostgreSQL role's password.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/rescuerelay_db?schema=public"

# Set to "postgres" only when DATABASE_URL is configured and migrations are applied.
# Default demo mode uses the mock repository with browser localStorage.
RESCUE_RELAY_PERSISTENCE="mock"

NODE_ENV="development"
DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Optional Google Maps JavaScript API key. Restrict it by website referrer and enable Maps JavaScript API.
# Without a key, the app shows a schematic fallback. This browser key is public; never put server-only secrets here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Server-only Maps key placeholder (unused in mock mode)
GOOGLE_MAPS_API_KEY=""

# Real account authentication (required for email/password registration and login)
# Create a verified sender in Resend, then set the server-side API key and sender.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
